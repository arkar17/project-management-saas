# Copy to .env for local development. Never commit real credentials.
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
DATABASE_URL=postgresql://pm:pm_local_only@localhost:5432/pm_dev
WEB_ORIGINS=http://localhost:5173
APP_BASE_URL=http://localhost:5173
TRUST_PROXY=0
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=PM SaaS <no-reply@pm.local>

# Private attachment storage (ADR-004). Local MinIO from docker-compose; the bucket stays private.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=pm-attachments
S3_ACCESS_KEY_ID=pm_local
S3_SECRET_ACCESS_KEY=pm_local_only
S3_FORCE_PATH_STYLE=true

# Seed only (prisma/seed.ts): provisions the Platform Super Admin (ADR-007).
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=
PLATFORM_ADMIN_NAME=Platform Admin
