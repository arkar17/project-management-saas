# Copy to .env.production on the server (never commit it). Placeholders only.
APP_DOMAIN=pm.example.com
NODE_ENV=production
PORT=4000
LOG_LEVEL=info
TRUST_PROXY=1

POSTGRES_USER=pm
POSTGRES_PASSWORD=change-me-long-random
POSTGRES_DB=pm_prod
DATABASE_URL=postgresql://pm:change-me-long-random@postgres:5432/pm_prod

WEB_ORIGINS=https://pm.example.com
APP_BASE_URL=https://pm.example.com

# Transactional SMTP provider (free tier is enough for a portfolio deployment)
SMTP_HOST=smtp.example-provider.com
SMTP_PORT=587
SMTP_USER=change-me
SMTP_PASSWORD=change-me
MAIL_FROM=PM SaaS <no-reply@pm.example.com>

# Private S3-compatible bucket (e.g. Cloudflare R2); no public access, CORS limited to APP_DOMAIN
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=pm-attachments
S3_ACCESS_KEY_ID=change-me
S3_SECRET_ACCESS_KEY=change-me
S3_FORCE_PATH_STYLE=true

WORKER_POLL_MS=2000

# One-time platform admin provisioning (npm run db:seed); remove after use
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=
