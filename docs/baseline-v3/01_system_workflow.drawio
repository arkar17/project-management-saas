        <mxCell id="note1" value="&lt;b&gt;Tenant scoping (Arch §7):&lt;/b&gt; the workspace is resolved from the authenticated membership and the URL resource ancestry (Issue → Project → Workspace) — never from a client-supplied workspaceId in the payload. List and mutation selectors always include workspaceId / projectId." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;shape=note;size=14;align=left;spacingLeft=6;spacingRight=6;verticalAlign=top;fontSize=11;fillColor=#fffde7;strokeColor=#bfa500;" vertex="1" parent="1">
          <mxGeometry x="30" y="880" width="560" height="100" as="geometry" />
        </mxCell>
        <mxCell id="note2" value="&lt;b&gt;Platform admin (FR-ADM-001/003):&lt;/b&gt; separate route namespace + policy guard; never bypasses resource authorization; tenant content (issues, comments, attachments) denied by default. Break-glass access requires future architecture approval." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;shape=note;size=14;align=left;spacingLeft=6;spacingRight=6;verticalAlign=top;fontSize=11;fillColor=#fffde7;strokeColor=#bfa500;" vertex="1" parent="1">
          <mxGeometry x="620" y="880" width="470" height="100" as="geometry" />
        </mxCell>
        <mxCell id="note3" value="&lt;b&gt;Decided ADRs (Baseline 3.0):&lt;/b&gt; ADR-001 APP/PLATFORM cookie sessions + CSRF · ADR-002 tenant authz · ADR-003 burndown · ADR-004 5-min signed URLs · ADR-005 outbox 8 attempts → DEAD · ADR-011 composite tenant FKs · ADR-018 scheduler." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;shape=note;size=14;align=left;spacingLeft=6;spacingRight=6;verticalAlign=top;fontSize=11;fillColor=#fffde7;strokeColor=#bfa500;" vertex="1" parent="1">
          <mxGeometry x="1110" y="880" width="560" height="100" as="geometry" />
        </mxCell>
