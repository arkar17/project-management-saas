        <mxCell id="hdr_title" value="How Workspace (Tenant) Isolation Works in the Data Model" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=22;fontStyle=1;fontColor=#1f4e79;" vertex="1" parent="1">
          <mxGeometry x="30" y="20" width="1200" height="34" as="geometry" />
        </mxCell>
        <mxCell id="hdr_sub" value="Every tenant-owned row reaches exactly one Workspace through a direct workspaceId column or an immutable FK chain. Authorization resolves the workspace from that ancestry — never from client input.&lt;br&gt;&lt;font color='#666666'&gt;&lt;i&gt;Traceability: SRS §6 invariant 1, FR-TEN-005, NFR-01; Arch §7, §8; AC-02, AC-09, AC-10&lt;/i&gt;&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#333333;" vertex="1" parent="1">
