        <mxCell id="lg5_sw0" value="" style="swimlane;startSize=28;html=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#2d7600;fontStyle=1;fontSize=12;swimlaneFillColor=#ffffff;fontFamily=Helvetica;" vertex="1" parent="lg5_box">
