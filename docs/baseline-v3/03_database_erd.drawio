        <mxCell id="auto34" value="audits&lt;br&gt;&lt;i&gt;workspaceId&lt;/i&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;startArrow=ERzeroToMany;endArrow=ERzeroToOne;startFill=0;endFill=0;strokeColor=#1f4e79;strokeWidth=2.5;labelBackgroundColor=#ffffff;fontColor=#1f4e79;fontFamily=Helvetica;dashed=1;" edge="1" parent="1" source="C_AuditLog" target="C_Workspace">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cn" value="&lt;b&gt;Reading guide&lt;/b&gt;&lt;br&gt;• User ⟷ Workspace is &lt;b&gt;N:M&lt;/b&gt; through WorkspaceMember (role OWNER/ADMIN/MEMBER).&lt;br&gt;• User ⟷ Project is &lt;b&gt;N:M&lt;/b&gt; through ProjectMember (role PROJECT_MANAGER/MEMBER); prerequisite: active WorkspaceMember.&lt;br&gt;• Owner = the single ACTIVE WorkspaceMember with role OWNER (partial unique index); no owner column (ADR-011).&lt;br&gt;• User 1:0..1 PlatformAdmin — platform authority only, never a workspace membership (ADR-007).&lt;br&gt;• Issue → Sprint is the &lt;b&gt;current&lt;/b&gt; sprint (0..1); historic participation is N:M via SprintIssueHistory.&lt;br&gt;• Actor references (Project.createdById, WorkspaceInvitation.invitedById, IssueComment.authorId, Attachment.uploaderId, IssueActivity.actorId, AuditLog.actorId, *ById columns) are shown on page 2 only." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;shape=note;size=14;align=left;spacingLeft=6;spacingRight=6;verticalAlign=top;fontSize=11;fillColor=#fffde7;strokeColor=#bfa500;" vertex="1" parent="1">
