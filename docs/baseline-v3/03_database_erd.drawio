        <mxCell id="env_NotificationType" value="ASSIGNED | MENTIONED | INVITE_ACCEPTED | WATCHED_ISSUE_UPDATED&lt;br&gt;&lt;font color='#7f7f7f'&gt;&lt;i&gt;FR-NTF-001&lt;/i&gt;&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;spacingLeft=6;whiteSpace=wrap;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="en_NotificationType">
          <mxGeometry x="0" y="26" width="390" height="70" as="geometry" />
        </mxCell>
        <mxCell id="en_AuditActorType" value="«enum» AuditActorType" style="swimlane;startSize=26;html=1;whiteSpace=wrap;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=12;swimlaneFillColor=#ffffff;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="450" y="680" width="390" height="96" as="geometry" />
        </mxCell>
        <mxCell id="env_AuditActorType" value="USER | PLATFORM_ADMIN | SYSTEM&lt;br&gt;&lt;font color='#7f7f7f'&gt;&lt;i&gt;FR-NTF-003, ADR-007&lt;/i&gt;&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;spacingLeft=6;whiteSpace=wrap;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="en_AuditActorType">
          <mxGeometry x="0" y="26" width="390" height="70" as="geometry" />
        </mxCell>
        <mxCell id="en_OutboxStatus" value="«enum» OutboxStatus" style="swimlane;startSize=26;html=1;whiteSpace=wrap;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=12;swimlaneFillColor=#ffffff;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="860" y="680" width="390" height="96" as="geometry" />
        </mxCell>
        <mxCell id="env_OutboxStatus" value="PENDING | PROCESSED | DEAD&lt;br&gt;&lt;font color='#7f7f7f'&gt;&lt;i&gt;ADR-005&lt;/i&gt;&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;spacingLeft=6;whiteSpace=wrap;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="en_OutboxStatus">
          <mxGeometry x="0" y="26" width="390" height="70" as="geometry" />
        </mxCell>
        <mxCell id="blk0" value="&lt;b&gt;Unique constraints&lt;/b&gt;&lt;br&gt;• Workspace(slug) · User(email) · tokenHash on Session, VerificationToken, WorkspaceInvitation&lt;br&gt;• WorkspaceMember(workspaceId, userId) · ProjectMember(projectId, userId)&lt;br&gt;• Project(workspaceId, key) · Issue(projectId, number)&lt;br&gt;• Label(projectId, name) · IssueWatcher(issueId, userId) · PlatformAdmin(userId)&lt;br&gt;• Attachment(objectKey) · SprintDailyMetric(sprintId, metricDate)&lt;br&gt;• Notification(recipientId, dedupeKey) · IssueLabel PK(issueId, labelId)&lt;br&gt;• Composite-FK targets: Project(id, workspaceId), Issue(id, workspaceId), Issue/Sprint/Label(id, projectId)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;shape=note;size=14;align=left;spacingLeft=6;spacingRight=6;verticalAlign=top;fontSize=11;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="40" y="810" width="590" height="250" as="geometry" />
        </mxCell>
        <mxCell id="blk1" value="&lt;b&gt;Partial uniques&lt;/b&gt;&lt;br&gt;• Sprint(projectId) WHERE status = 'ACTIVE'&lt;br&gt;• WorkspaceMember(workspaceId) WHERE role='OWNER' AND status='ACTIVE'&lt;br&gt;• WorkspaceInvitation(workspaceId, email) WHERE state = 'PENDING'&lt;br&gt;• SprintIssueHistory(sprintId, issueId) WHERE removedAt IS NULL" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;shape=note;size=14;align=left;spacingLeft=6;spacingRight=6;verticalAlign=top;fontSize=11;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="650" y="810" width="590" height="250" as="geometry" />
        </mxCell>
        <mxCell id="blk2" value="&lt;b&gt;Indexes&lt;/b&gt;&lt;br&gt;• Issue(projectId, status, rank) · (assigneeId, status) · (projectId, sprintId) · (parentId)&lt;br&gt;• WorkspaceInvitation(workspaceId, email, state)&lt;br&gt;• Notification(recipientId, readAt, createdAt)&lt;br&gt;• IssueWatcher(userId) · SprintIssueHistory(issueId)&lt;br&gt;• OutboxEvent(status, availableAt) · AuditLog(workspaceId, createdAt) · Session(userId)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;shape=note;size=14;align=left;spacingLeft=6;spacingRight=6;verticalAlign=top;fontSize=11;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="1260" y="810" width="590" height="250" as="geometry" />
        </mxCell>
        <mxCell id="blk3" value="&lt;b&gt;Transactions&lt;/b&gt;&lt;br&gt;• Workspace creation (+ OWNER) · ownership transfer · role change&lt;br&gt;• Member removal cascade · invitation resend / accept&lt;br&gt;• Issue number allocation (row lock on Project) · delete / restore&lt;br&gt;• Sprint start / complete / cancel · comment moderation&lt;br&gt;• Every mutation + its OutboxEvent / AuditLog / IssueActivity" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;shape=note;size=14;align=left;spacingLeft=6;spacingRight=6;verticalAlign=top;fontSize=11;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="40" y="1080" width="590" height="250" as="geometry" />
        </mxCell>
        <mxCell id="blk4" value="&lt;b&gt;Checks, deletes &amp;amp; immutability&lt;/b&gt;&lt;br&gt;• Attachment.sizeBytes ≤ 10 MB; Issue.storyPoints 0–100&lt;br&gt;• Sprint.startAt &lt; endAt; Project.startDate ≤ targetDate&lt;br&gt;• Project.key, Issue.number/key, Issue.projectId immutable&lt;br&gt;• All FKs ON DELETE RESTRICT; IssueLabel.labelId CASCADE&lt;br&gt;• No hard delete of users, workspaces, projects, issues, comments, activity, audit" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;shape=note;size=14;align=left;spacingLeft=6;spacingRight=6;verticalAlign=top;fontSize=11;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="650" y="1080" width="590" height="250" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="51e9912c149c832aa59e" name="5 Baseline 3.0 Change Log">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1000" math="0" shadow="0" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="hdr_title" value="Data-Model Changes v2 → v3 (approved)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=22;fontStyle=1;fontColor=#1f4e79;" vertex="1" parent="1">
          <mxGeometry x="30" y="20" width="1200" height="34" as="geometry" />
        </mxCell>
        <mxCell id="hdr_sub" value="All former gaps are resolved; every change below is reflected on pages 1–4 and in Architecture v3 §4. Green = added, red = removed / renamed.&lt;br&gt;&lt;font color='#666666'&gt;&lt;i&gt;Traceability: ADR-006…ADR-019; INC-01…INC-27; FR-ADM-001, FR-ISS-010, FR-PRJ-001, FR-TEN-002/004&lt;/i&gt;&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="30" y="56" width="1200" height="44" as="geometry" />
        </mxCell>
        <mxCell id="g1" value="NEW entity PlatformAdmin (ADR-007, INC-03)" style="swimlane;startSize=28;html=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#2d7600;fontStyle=1;fontSize=12;swimlaneFillColor=#ffffff;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="140" width="440" height="118" as="geometry" />
        </mxCell>
        <mxCell id="g1_b" value="userId FK UQ → User&lt;br&gt;status ACTIVE|REVOKED, grantedAt,&lt;br&gt;grantedById, revokedAt&lt;br&gt;Session.kind APP|PLATFORM added" style="text;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=11;whiteSpace=wrap;fontFamily=Courier New;" vertex="1" parent="g1">
          <mxGeometry x="0" y="28" width="440" height="90" as="geometry" />
        </mxCell>
        <mxCell id="g2" value="NEW entity IssueWatcher (ADR-010, INC-02)" style="swimlane;startSize=28;html=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#2d7600;fontStyle=1;fontSize=12;swimlaneFillColor=#ffffff;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="500" y="140" width="440" height="118" as="geometry" />
        </mxCell>
        <mxCell id="g2_b" value="issueId FK, userId FK, createdAt&lt;br&gt;UQ(issueId, userId)&lt;br&gt;auto: reporter + assignee&lt;br&gt;removed on access revocation" style="text;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=11;whiteSpace=wrap;fontFamily=Courier New;" vertex="1" parent="g2">
          <mxGeometry x="0" y="28" width="440" height="90" as="geometry" />
        </mxCell>
        <mxCell id="g3" value="ADDED columns (ADR-009/012/013/014/017)" style="swimlane;startSize=28;html=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#2d7600;fontStyle=1;fontSize=12;swimlaneFillColor=#ffffff;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="960" y="140" width="440" height="240" as="geometry" />
        </mxCell>
        <mxCell id="g3_b" value="Project: status enum, startDate, targetDate,&lt;br&gt;  archivedById, createdAt, updatedAt&lt;br&gt;Issue/Sprint/Label: createdAt (+updatedAt)&lt;br&gt;Workspace: timezone, suspendedAt&lt;br&gt;Member rows: status, removedAt&lt;br&gt;Invitation: createdAt, accepted*/revoked*&lt;br&gt;Comment: deletedById, moderationReason&lt;br&gt;SprintIssueHistory: projectId, completedPoints&lt;br&gt;Sprint: cancelledAt; Outbox: status, availableAt" style="text;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=11;whiteSpace=wrap;fontFamily=Courier New;" vertex="1" parent="g3">
          <mxGeometry x="0" y="28" width="440" height="212" as="geometry" />
        </mxCell>
        <mxCell id="g4" value="REMOVED / CHANGED (ADR-011/014/019)" style="swimlane;startSize=28;html=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;fontSize=12;swimlaneFillColor=#ffffff;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1420" y="140" width="440" height="150" as="geometry" />
        </mxCell>
        <mxCell id="g4_b" value="Workspace.ownerUserId — removed&lt;br&gt;Issue.archivedAt → deletedAt + deletedById&lt;br&gt;AuditLog.actorId → FK NULL + actorType&lt;br&gt;IssueType += SUBTASK; SprintStatus += CANCELLED&lt;br&gt;IssueLabel += projectId (composite FKs)" style="text;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=11;whiteSpace=wrap;fontFamily=Courier New;" vertex="1" parent="g4">
          <mxGeometry x="0" y="28" width="440" height="122" as="geometry" />
        </mxCell>
        <mxCell id="red" value="&lt;b&gt;Cardinality corrections (INC-04):&lt;/b&gt; owner is a WorkspaceMember role, so the former 'Workspace 1:1 User' is gone; User 1:N now lists every actor column; Issue 1:N SprintIssueHistory and Issue 1:N IssueWatcher are explicit; User 1:0..1 PlatformAdmin." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;shape=note;size=14;align=left;spacingLeft=6;spacingRight=6;verticalAlign=top;fontSize=11;fillColor=#fffde7;strokeColor=#bfa500;" vertex="1" parent="1">
          <mxGeometry x="40" y="420" width="1820" height="70" as="geometry" />
        </mxCell>
        <mxCell id="lg5_box" value="&lt;b&gt;Legend&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;fillColor=#ffffff;strokeColor=#999999;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="520" width="260" height="90" as="geometry" />
