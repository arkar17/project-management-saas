        <mxCell id="auto33" value="about issue&lt;br&gt;&lt;i&gt;issueId&lt;/i&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;startArrow=ERzeroToMany;endArrow=ERzeroToOne;startFill=0;endFill=0;strokeColor=#c55a11;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontColor=#c55a11;fontFamily=Helvetica;dashed=1;" edge="1" parent="1" source="C_Notification" target="C_Issue">
