  <diagram id="23c342463b318bdb5123" name="1 Permission Hierarchy">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1250" math="0" shadow="0" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="hdr_title" value="Permission Hierarchy — Two Planes, Two Tenant Layers" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=22;fontStyle=1;fontColor=#1f4e79;" vertex="1" parent="1">
          <mxGeometry x="30" y="20" width="1200" height="34" as="geometry" />
        </mxCell>
        <mxCell id="hdr_sub" value="Platform plane is isolated from tenant content. Inside a tenant, privileges are evaluated from WorkspaceMember (OWNER/ADMIN/MEMBER) and ProjectMember (PROJECT_MANAGER/MEMBER). There is no global end-user role.&lt;br&gt;&lt;font color='#666666'&gt;&lt;i&gt;Traceability: SRS v3 §3, §4, §6, §10; FR-ADM-001…004; ADR-002, ADR-007, ADR-008, ADR-012&lt;/i&gt;&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="30" y="56" width="1200" height="44" as="geometry" />
        </mxCell>
        <mxCell id="zp" value="PLATFORM PLANE" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;dashed=1;fontFamily=Helvetica;fillColor=#f6f0fa;strokeColor=#7030a0;fontColor=#7030a0;" vertex="1" parent="1">
          <mxGeometry x="40" y="120" width="520" height="470" as="geometry" />
        </mxCell>
        <mxCell id="sa" value="&lt;b&gt;Platform Super Admin&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;✔ separate sign-in gate + /platform routes&lt;br&gt;✔ tenant list &amp;amp; operational metadata&lt;br&gt;✔ platform metrics, job health&lt;br&gt;✔ suspend / reactivate workspace (reason + audit)&lt;br&gt;✘ issues, comments, attachments (deny-by-default)&lt;br&gt;✘ not part of the tenant matrix&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=20;fontColor=#ffffff;fontStyle=1;fillColor=#7030a0;strokeColor=#4b1f6e;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="70" y="170" width="460" height="170" as="geometry" />
        </mxCell>
        <mxCell id="sag" value="Identity: User + ACTIVE &lt;b&gt;PlatformAdmin&lt;/b&gt; record (seed/CLI only); PLATFORM session kind (ADR-007)." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;shape=note;size=14;align=left;spacingLeft=6;spacingRight=6;verticalAlign=top;fontSize=11;fillColor=#fffde7;strokeColor=#bfa500;" vertex="1" parent="1">
          <mxGeometry x="70" y="360" width="460" height="50" as="geometry" />
        </mxCell>
        <mxCell id="sabg" value="&lt;b&gt;Break-glass access&lt;/b&gt;: not in Release 1.0 — needs separate future architecture approval (Arch §7)." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;shape=note;size=14;align=left;spacingLeft=6;spacingRight=6;verticalAlign=top;fontSize=11;fillColor=#fffde7;strokeColor=#bfa500;" vertex="1" parent="1">
          <mxGeometry x="70" y="430" width="460" height="60" as="geometry" />
        </mxCell>
        <mxCell id="wall" value="DENY-BY-DEFAULT&lt;br&gt;tenant content wall" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=3;dashed=1;fontColor=#b85450;fontStyle=1;horizontal=0;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="590" y="120" width="70" height="470" as="geometry" />
        </mxCell>
        <mxCell id="zt" value="TENANT PLANE — one Workspace (repeat per workspace)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;dashed=1;fontFamily=Helvetica;fillColor=#f3f8fd;strokeColor=#1f4e79;fontColor=#1f4e79;" vertex="1" parent="1">
          <mxGeometry x="690" y="120" width="1170" height="1000" as="geometry" />
        </mxCell>
        <mxCell id="zw" value="Workspace layer · WorkspaceMember.role" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;dashed=1;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#2e75b6;fontColor=#2e75b6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="720" y="160" width="520" height="520" as="geometry" />
        </mxCell>
        <mxCell id="own" value="&lt;b&gt;Workspace Owner (exactly one)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;highest business authority · transfer ownership&lt;br&gt;full workspace + project admin on ALL projects&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=20;fontColor=#ffffff;fontStyle=1;fillColor=#1f4e79;strokeColor=#12304d;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="750" y="200" width="460" height="90" as="geometry" />
        </mxCell>
        <mxCell id="adm" value="&lt;b&gt;Workspace Admin&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;manage members, invites, settings, projects&lt;br&gt;full project admin on ALL projects&lt;br&gt;✘ ownership transfer · ✘ owner demotion&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=20;fontColor=#ffffff;fontStyle=1;fillColor=#2e75b6;strokeColor=#1f5280;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="750" y="340" width="460" height="100" as="geometry" />
        </mxCell>
        <mxCell id="wsm" value="&lt;b&gt;Workspace Member (baseline)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;workspace shell, own profile, notifications&lt;br&gt;sees only projects where a ProjectMember row exists&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=20;fontColor=#ffffff;fontStyle=1;fillColor=#a6a6a6;strokeColor=#7f7f7f;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="750" y="490" width="460" height="90" as="geometry" />
        </mxCell>
        <mxCell id="auto1" value="⊇ includes" style="rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="own" target="adm">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="auto2" value="⊇ includes" style="rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="adm" target="wsm">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="zpr" value="Project layer · ProjectMember.role (per project)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;dashed=1;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#548235;fontColor=#548235;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1290" y="160" width="540" height="520" as="geometry" />
        </mxCell>
        <mxCell id="pm" value="&lt;b&gt;Project Manager&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;project settings &amp;amp; membership, labels, all issue fields&lt;br&gt;(never project), backlog ranking, sprints, reports&lt;br&gt;✘ grant workspace privileges&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=20;fontColor=#ffffff;fontStyle=1;fillColor=#548235;strokeColor=#3a5b25;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1320" y="230" width="480" height="110" as="geometry" />
        </mxCell>
        <mxCell id="pmem" value="&lt;b&gt;Project Member&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;view project · create issues · edit OWN assigned/reported&lt;br&gt;(title, description, due date, status — form or board)&lt;br&gt;· comment / attach / watch · read reports&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=20;fontColor=#ffffff;fontStyle=1;fillColor=#7f7f7f;strokeColor=#595959;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1320" y="420" width="480" height="120" as="geometry" />
        </mxCell>
        <mxCell id="auto3" value="⊇ includes" style="rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="pm" target="pmem">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="auto4" value="implicit full project admin" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;strokeColor=#1f4e79;strokeWidth=2;dashed=1;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.12;entryDx=0;entryDy=0;" edge="1" parent="1" source="own" target="zpr">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="auto5" value="implicit full project admin" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;strokeColor=#2e75b6;strokeWidth=2;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.42;entryDx=0;entryDy=0;" edge="1" parent="1" source="adm" target="zpr">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="auto6" value="needs ACTIVE ProjectMember row&lt;br&gt;(prerequisite: ACTIVE WorkspaceMember)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;strokeColor=#548235;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.6;entryDx=0;entryDy=0;" edge="1" parent="1" source="wsm" target="pmem">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="eff" value="&lt;b&gt;Effective privilege&lt;/b&gt; = max( workspace grant , project grant )&lt;br&gt;• OWNER / ADMIN ⇒ project-admin capabilities on every project in that workspace, with or without a ProjectMember row.&lt;br&gt;• MEMBER ⇒ only what the ProjectMember role grants on that specific project; removal from the workspace revokes all project access (ADR-012).&lt;br&gt;• Job title (Developer / Designer / QA) is profile metadata — never a permission input.&lt;br&gt;• A user may hold different roles in different workspaces and projects." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;shape=note;size=14;align=left;spacingLeft=6;spacingRight=6;verticalAlign=top;fontSize=11;fillColor=#fffde7;strokeColor=#bfa500;" vertex="1" parent="1">
          <mxGeometry x="720" y="710" width="1110" height="130" as="geometry" />
        </mxCell>
        <mxCell id="zex" value="Example — one User, many memberships" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;dashed=1;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#7f7f7f;fontColor=#595959;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="720" y="870" width="1110" height="230" as="geometry" />
        </mxCell>
        <mxCell id="alice" value="&lt;b&gt;User: Alice&lt;/b&gt;&lt;br&gt;(single identity,&lt;br&gt;no global role)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=12;fillColor=#eeeeee;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="750" y="930" width="170" height="140" as="geometry" />
        </mxCell>
        <mxCell id="exA" value="&lt;b&gt;Workspace A → OWNER&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;admin of all A projects&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=20;fontColor=#ffffff;fontStyle=1;fillColor=#1f4e79;strokeColor=#12304d;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="980" y="905" width="250" height="60" as="geometry" />
        </mxCell>
        <mxCell id="exB" value="&lt;b&gt;Workspace B → MEMBER&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;no rights outside her projects&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=20;fontColor=#ffffff;fontStyle=1;fillColor=#a6a6a6;strokeColor=#7f7f7f;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="980" y="1010" width="250" height="60" as="geometry" />
        </mxCell>
        <mxCell id="exB1" value="&lt;b&gt;B / Project WEB → PM&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=20;fontColor=#ffffff;fontStyle=1;fillColor=#548235;strokeColor=#3a5b25;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1290" y="990" width="240" height="40" as="geometry" />
        </mxCell>
        <mxCell id="exB2" value="&lt;b&gt;B / Project API → MEMBER&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=20;fontColor=#ffffff;fontStyle=1;fillColor=#7f7f7f;strokeColor=#595959;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1290" y="1045" width="240" height="40" as="geometry" />
        </mxCell>
        <mxCell id="exB3" value="B / Project OPS → no row ⇒ 404" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=12;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1560" y="1018" width="240" height="40" as="geometry" />
        </mxCell>
        <mxCell id="auto7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="alice" target="exA">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="auto8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="alice" target="exB">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="auto9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="exB" target="exB1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="auto10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="exB" target="exB2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="auto11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#b85450;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;dashed=1;fontColor=#b85450;" edge="1" parent="1" source="exB" target="exB3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="ad28eef4ebf0df129f53" name="2 Effective Role Resolution">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1350" math="0" shadow="0" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="hdr_title" value="Effective Role Resolution (per request)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=22;fontStyle=1;fontColor=#1f4e79;" vertex="1" parent="1">
          <mxGeometry x="30" y="20" width="1200" height="34" as="geometry" />
        </mxCell>
        <mxCell id="hdr_sub" value="Computed server-side from the resource ancestry; the client never supplies the role or the workspace.&lt;br&gt;&lt;font color='#666666'&gt;&lt;i&gt;Traceability: SRS §3 decision, §4 footnote, §6; FR-TEN-005; Arch §7; AC-02, AC-03&lt;/i&gt;&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="30" y="56" width="1200" height="44" as="geometry" />
        </mxCell>
        <mxCell id="e0" value="User U → action X&lt;br&gt;on resource R" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;ellipse;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="290" y="132" width="180" height="56" as="geometry" />
        </mxCell>
        <mxCell id="e1" value="Resolve W (workspace) and&lt;br&gt;P (project, if any) from R" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="265" y="248" width="230" height="64" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="U is ACTIVE&lt;br&gt;member of W?" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rhombus;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="290" y="352" width="180" height="96" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="W SUSPENDED?" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rhombus;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="290" y="472" width="180" height="96" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="WorkspaceMember&lt;br&gt;.role = OWNER?" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rhombus;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="290" y="592" width="180" height="96" as="geometry" />
        </mxCell>
        <mxCell id="e5" value="role = ADMIN?" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rhombus;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="290" y="712" width="180" height="96" as="geometry" />
        </mxCell>
        <mxCell id="e6" value="R is project-&lt;br&gt;scoped?" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rhombus;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="290" y="832" width="180" height="96" as="geometry" />
        </mxCell>
        <mxCell id="e7" value="ACTIVE ProjectMember&lt;br&gt;(P, U)?" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rhombus;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="290" y="952" width="180" height="96" as="geometry" />
        </mxCell>
        <mxCell id="e8" value="role =&lt;br&gt;PROJECT_MANAGER?" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rhombus;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="290" y="1072" width="180" height="96" as="geometry" />
        </mxCell>
        <mxCell id="rMem" value="&lt;b&gt;PROJECT MEMBER&lt;/b&gt;&lt;br&gt;+ per-issue ownership test&lt;br&gt;(assignee / reporter)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=20;fontColor=#ffffff;fontStyle=1;fillColor=#7f7f7f;strokeColor=#595959;" vertex="1" parent="1">
          <mxGeometry x="265" y="1205" width="230" height="70" as="geometry" />
        </mxCell>
        <mxCell id="rNone" value="&lt;b&gt;NONE&lt;/b&gt; → 404 (hidden)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=12;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="645" y="370" width="230" height="60" as="geometry" />
        </mxCell>
        <mxCell id="rSus" value="&lt;b&gt;SUSPENDED&lt;/b&gt; → 403 for every tenant action" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=12;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="645" y="490" width="230" height="60" as="geometry" />
        </mxCell>
        <mxCell id="rOwn" value="&lt;b&gt;OWNER&lt;/b&gt;&lt;br&gt;all workspace + all projects&lt;br&gt;+ ownership transfer" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=20;fontColor=#ffffff;fontStyle=1;fillColor=#1f4e79;strokeColor=#12304d;" vertex="1" parent="1">
          <mxGeometry x="645" y="605" width="230" height="70" as="geometry" />
        </mxCell>
        <mxCell id="rAdm" value="&lt;b&gt;ADMIN&lt;/b&gt;&lt;br&gt;all workspace + all projects&lt;br&gt;✘ ownership" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=20;fontColor=#ffffff;fontStyle=1;fillColor=#2e75b6;strokeColor=#1f5280;" vertex="1" parent="1">
