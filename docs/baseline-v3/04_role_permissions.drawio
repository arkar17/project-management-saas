        </mxCell>
        <mxCell id="fr4" value="&lt;b&gt;Project Member&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=20;fontColor=#ffffff;fontStyle=1;fillColor=#7f7f7f;strokeColor=#595959;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1270" y="130" width="290" height="50" as="geometry" />
        </mxCell>
        <mxCell id="fl4" value="✘ Edit issues not assigned / reported&lt;br&gt;✘ Change assignee, sprint, points, priority&lt;br&gt;✘ Change type, parent, labels after create&lt;br&gt;✘ Reorder backlog / board ranking&lt;br&gt;✘ Manage sprints / backlog&lt;br&gt;✘ Project settings / membership&lt;br&gt;✘ Soft-delete / restore issues&lt;br&gt;✘ Edit comment after 15 min&lt;br&gt;✘ Download files of other projects" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=12;strokeColor=#b85450;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;fontSize=12;fillColor=#fdf3f2;" vertex="1" parent="1">
          <mxGeometry x="1270" y="190" width="290" height="380" as="geometry" />
        </mxCell>
        <mxCell id="fr5" value="&lt;b&gt;Workspace Member (no project row)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=20;fontColor=#ffffff;fontStyle=1;fillColor=#a6a6a6;strokeColor=#7f7f7f;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1580" y="130" width="290" height="50" as="geometry" />
        </mxCell>
        <mxCell id="fl5" value="✘ See or search that project&lt;br&gt;✘ Create issues there&lt;br&gt;✘ Read its reports&lt;br&gt;✘ Receive its notifications&lt;br&gt;✘ See member emails / invitations" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=12;strokeColor=#b85450;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;fontSize=12;fillColor=#fdf3f2;" vertex="1" parent="1">
          <mxGeometry x="1580" y="190" width="290" height="380" as="geometry" />
        </mxCell>
        <mxCell id="funi" value="Universal: no role may change an issue's project, mutate an archived project, act in a suspended workspace, skip the version check, or reach another tenant. All checks run in the API; the frontend only hides controls for discoverability." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;shape=note;size=14;align=left;spacingLeft=6;spacingRight=6;verticalAlign=top;fontSize=11;fillColor=#fffde7;strokeColor=#bfa500;" vertex="1" parent="1">
