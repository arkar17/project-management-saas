  <diagram id="c5fb504728c243f7adfa" name="6 Forbidden Actions by Role">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="900" math="0" shadow="0" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="hdr_title" value="Explicitly Forbidden Actions by Role" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=22;fontStyle=1;fontColor=#1f4e79;" vertex="1" parent="1">
          <mxGeometry x="30" y="20" width="1200" height="34" as="geometry" />
        </mxCell>
        <mxCell id="hdr_sub" value="What each role must NOT be able to do, even by calling the API directly. Every item is a negative test case.&lt;br&gt;&lt;font color='#666666'&gt;&lt;i&gt;Traceability: SRS §3, §4, §6, §10; FR-ADM-003; FR-AUTH-004; FR-TEN-004; FR-ISS-007&lt;/i&gt;&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="30" y="56" width="1200" height="44" as="geometry" />
        </mxCell>
        <mxCell id="fr0" value="&lt;b&gt;Platform Super Admin&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=20;fontColor=#ffffff;fontStyle=1;fillColor=#7030a0;strokeColor=#4b1f6e;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="30" y="130" width="290" height="50" as="geometry" />
        </mxCell>
        <mxCell id="fl0" value="✘ Browse issues, comments, attachments&lt;br&gt;✘ Join / impersonate a tenant&lt;br&gt;✘ Gain membership via PlatformAdmin&lt;br&gt;✘ Bypass resource authorization&lt;br&gt;✘ Suspend without reason + audit&lt;br&gt;✘ Use tenant routes with platform session" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=12;strokeColor=#b85450;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;fontSize=12;fillColor=#fdf3f2;" vertex="1" parent="1">
          <mxGeometry x="30" y="190" width="290" height="380" as="geometry" />
        </mxCell>
        <mxCell id="fr1" value="&lt;b&gt;Workspace Owner&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=20;fontColor=#ffffff;fontStyle=1;fillColor=#1f4e79;strokeColor=#12304d;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="340" y="130" width="290" height="50" as="geometry" />
        </mxCell>
        <mxCell id="fl1" value="✘ Permanently delete issues&lt;br&gt;✘ Leave / self-demote while Owner&lt;br&gt;✘ Deactivate account while owning (FR-AUTH-004)&lt;br&gt;✘ Create a 2nd Owner (non-transfer)&lt;br&gt;✘ Read another workspace's data" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=12;strokeColor=#b85450;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;fontSize=12;fillColor=#fdf3f2;" vertex="1" parent="1">
          <mxGeometry x="340" y="190" width="290" height="380" as="geometry" />
        </mxCell>
        <mxCell id="fr2" value="&lt;b&gt;Workspace Admin&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=20;fontColor=#ffffff;fontStyle=1;fillColor=#2e75b6;strokeColor=#1f5280;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="650" y="130" width="290" height="50" as="geometry" />
        </mxCell>
        <mxCell id="fl2" value="✘ Transfer ownership&lt;br&gt;✘ Demote / remove the Owner&lt;br&gt;✘ Permanently delete issues&lt;br&gt;✘ Platform suspension&lt;br&gt;✘ Read another workspace's data" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=12;strokeColor=#b85450;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;fontSize=12;fillColor=#fdf3f2;" vertex="1" parent="1">
          <mxGeometry x="650" y="190" width="290" height="380" as="geometry" />
        </mxCell>
        <mxCell id="fr3" value="&lt;b&gt;Project Manager&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=20;fontColor=#ffffff;fontStyle=1;fillColor=#548235;strokeColor=#3a5b25;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="960" y="130" width="290" height="50" as="geometry" />
        </mxCell>
        <mxCell id="fl3" value="✘ Change an issue's project&lt;br&gt;✘ Grant workspace roles&lt;br&gt;✘ Invite to workspace / change ws settings&lt;br&gt;✘ Create / archive projects&lt;br&gt;✘ Add non-workspace users to project&lt;br&gt;✘ Access projects without membership&lt;br&gt;✘ Permanently delete issues" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=12;strokeColor=#b85450;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;fontSize=12;fillColor=#fdf3f2;" vertex="1" parent="1">
