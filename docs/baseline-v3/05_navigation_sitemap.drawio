          <mxGeometry x="1285" y="205" width="250" height="36" as="geometry" />
        </mxCell>
        <mxCell id="mb_card0" value="WEB-12  card&lt;br&gt;&lt;font style='font-size:9px'&gt;⋯ Move to…&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1295" y="250" width="230" height="70" as="geometry" />
        </mxCell>
        <mxCell id="mb_card1" value="WEB-13  card&lt;br&gt;&lt;font style='font-size:9px'&gt;⋯ Move to…&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1295" y="330" width="230" height="70" as="geometry" />
        </mxCell>
        <mxCell id="mb_card2" value="WEB-14  card&lt;br&gt;&lt;font style='font-size:9px'&gt;⋯ Move to…&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1295" y="410" width="230" height="70" as="geometry" />
        </mxCell>
        <mxCell id="mb_n" value="Issue opens as full-screen route (not modal)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;shape=note;size=14;align=left;spacingLeft=6;spacingRight=6;verticalAlign=top;fillColor=#fffde7;strokeColor=#bfa500;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1285" y="500" width="250" height="50" as="geometry" />
        </mxCell>
        <mxCell id="mb_bot" value="Overview · Issues · Board · Backlog · More" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=12;fillColor=#404040;strokeColor=#262626;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1285" y="650" width="250" height="50" as="geometry" />
        </mxCell>
        <mxCell id="mb_drw" value="Drawer (☰): workspace switcher, project list, account, theme" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=12;strokeColor=#6c8ebf;fillColor=#f3f8fd;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1285" y="565" width="250" height="70" as="geometry" />
        </mxCell>
        <mxCell id="cons" value="&lt;b&gt;Navigation considerations&lt;/b&gt;&lt;br&gt;• &lt;b&gt;Board&lt;/b&gt;: desktop shows all 5 columns; tablet scrolls horizontally in-container; mobile shows one column with a picker. Drag-and-drop always has a keyboard / touch 'Move to…' action (FR-BRD-004).&lt;br&gt;• &lt;b&gt;Issue detail&lt;/b&gt;: modal on desktop/tablet, full-screen route on mobile; both share the same deep link.&lt;br&gt;• &lt;b&gt;Tables&lt;/b&gt; (issues, members, tenants) become card lists below 768 px; filters move into a bottom sheet.&lt;br&gt;• &lt;b&gt;Reports&lt;/b&gt;: charts stack vertically; every chart has an accessible data-table alternative.&lt;br&gt;• &lt;b&gt;Workspace switch&lt;/b&gt; always triggers server re-authorisation and cache reset (FR-TEN-005) to avoid cross-tenant cache bleed.&lt;br&gt;• &lt;b&gt;Role-restricted items&lt;/b&gt; are hidden in sidebar / bottom bar; typed URLs show the 403 state, hidden resources 404.&lt;br&gt;• &lt;b&gt;Platform admin&lt;/b&gt; uses its own minimal shell (no workspace switcher, no bell).&lt;br&gt;• &lt;b&gt;Accessibility&lt;/b&gt;: skip-to-content link, visible focus, labelled controls, error summaries, WCAG 2.2 AA target (NFR-06).&lt;br&gt;• &lt;b&gt;System states&lt;/b&gt;: loading skeletons, empty, error (with requestId), forbidden, archived, suspended in every module (FR-UX-003)." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;shape=note;size=14;align=left;spacingLeft=6;spacingRight=6;verticalAlign=top;fillColor=#fffde7;strokeColor=#bfa500;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="30" y="740" width="1520" height="250" as="geometry" />
        </mxCell>
        <mxCell id="mbb" value="&lt;b&gt;Mobile bottom bar (project context)&lt;/b&gt;&lt;br&gt;Overview · Issues · Board · Backlog · More&lt;br&gt;'More' → Sprints, Reports, Members*, Settings*&lt;br&gt;&lt;br&gt;&lt;b&gt;Outside a project&lt;/b&gt; the bottom bar is replaced by workspace tabs: Overview · Projects · Notifications · Account." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;shape=note;size=14;align=left;spacingLeft=6;spacingRight=6;verticalAlign=top;fontSize=11;fillColor=#fffde7;strokeColor=#bfa500;" vertex="1" parent="1">
