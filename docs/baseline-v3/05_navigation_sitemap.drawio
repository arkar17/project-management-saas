        <mxCell id="mb" value="Mobile 390 px" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#404040;fontColor=#404040;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="1270" y="120" width="280" height="600" as="geometry" />
        </mxCell>
        <mxCell id="mb_top" value="☰  WEB · Board        🔔3" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=12;fillColor=#404040;strokeColor=#262626;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1285" y="150" width="250" height="44" as="geometry" />
        </mxCell>
